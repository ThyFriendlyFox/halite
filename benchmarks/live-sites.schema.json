{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ThyFriendlyFox/halite/main/benchmarks/live-sites.schema.json",
  "title": "HaliteLiveSites",
  "type": "object",
  "required": ["version", "sites"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "description": { "type": "string" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probe": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1000 },
        "minTools": { "type": "integer", "minimum": 0 }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "tier", "kind", "why"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "url": { "type": "string", "format": "uri" },
          "tier": { "enum": ["core", "soft"] },
          "kind": {
            "enum": [
              "spa-controls",
              "html-form",
              "ecommerce",
              "webmcp-demo",
              "docs",
              "negative"
            ]
          },
          "why": { "type": "string", "minLength": 1 },
          "probe": { "type": "boolean" },
          "timeoutMs": { "type": "integer", "minimum": 1000 },
          "minTools": { "type": "integer", "minimum": 0 },
          "maxTools": { "type": "integer", "minimum": 0 },
          "expectNameContains": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
